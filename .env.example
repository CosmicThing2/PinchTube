# Copy to .env next to docker-compose.yml and adjust. Everything is optional;
# the values shown are the defaults.

# Where your downloaded videos live on the host (mounted read-only at /media).
MEDIA_PATH=./media

# Port on the host, and which address to listen on. 127.0.0.1 only accepts
# connections from this machine (e.g. when a reverse proxy here is the way in).
HOST_PORT=8150
BIND_ADDRESS=0.0.0.0

# Time zone for log timestamps, e.g. Europe/London, America/New_York.
TZ=Etc/UTC

# The user the app runs as. It takes ownership of ./data/config and ./data/cache.
PUID=1000
PGID=1000

# AMD / Intel GPUs only: the group that owns the render node on the host.
#   stat -c '%g' /dev/dri/renderD128
RENDER_GID=44

# auto = Secure cookie whenever the request came in over HTTPS.
SECURE_COOKIES=auto
# true only when a reverse proxy sits in front of the app.
TRUST_PROXY=false

LOG_LEVEL=info
